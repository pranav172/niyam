# =====================================================================
# NIYAM (नियम) Configuration Template
# All fields are OPTIONAL. If omitted, NIYAM operates in high-fidelity
# zero-config offline simulator mode (100% demo reliable).
# =====================================================================

# Server & Network
PORT=8000
ENVIRONMENT=development
# Public URL when deployed to Render, Railway, or tunneled via ngrok (e.g. https://xxxx.ngrok-free.app)
PUBLIC_BASE_URL=http://localhost:8000

# 1. Natural Language LLM Compiler (Optional)
# If provided, policies are compiled with real LLM structured outputs.
# If omitted or network fails, built-in deterministic extractor runs offline.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=

# 2. Razorpay Payment Rails (Optional)
# If provided, authentic test/live payment links with UPI/Card are generated.
# If omitted, authentic high-fidelity test sandbox links (rzp.io/i/test_...) are returned.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 3. WhatsApp Exception Alerts & 1-Tap Mobile Approvals (Optional)
# If provided via Twilio, real WhatsApp notifications are dispatched on budget breaches.
# If omitted, alerts are displayed visually in the interactive WhatsApp smartphone modal.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Default principal phone number to receive WhatsApp exception alerts
DEFAULT_PRINCIPAL_PHONE=+919876543210
